{
  "name": "fretboard-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/make-404.mjs",
    "build:test": "vite build --mode test && node scripts/make-404.mjs",
    "build:test:skew": "node scripts/build-next-version.mjs",
    "preview": "vite preview",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format:check": "prettier --check . --cache",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:nojs": "playwright test --project=nojs",
    "test:e2e:fast": "playwright test -c pw.local.config.ts --project=desktop",
    "verify": "node scripts/verify.mjs",
    "lhci": "lhci autorun",
    "fonts:accidentals": "node scripts/subset-accidentals-font.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-music": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "valibot": "^1"
  }
}
